# tinrom - (C) 2026 TinWhisker - MIT licensed
cmake_minimum_required(VERSION 3.25)

message(STATUS "")
message(STATUS "tinrom ${PROJECT_VERSION}")
if(TINROM_BUILD_STAMP)
	message(STATUS "  build stamp    : pinned to ${TINROM_BUILD_STAMP}")
else()
	message(STATUS "  build stamp    : from the clock, every build")
endif()
message(STATUS "  toolchain      : ${CMAKE_C_COMPILER}")
if(tinromBareMetalRevision)
	message(STATUS "  ps1-bare-metal : ${TINROM_BARE_METAL_DIR} (${tinromBareMetalRevision})")
else()
	message(STATUS "  ps1-bare-metal : ${TINROM_BARE_METAL_DIR}")
endif()
message(STATUS "  default tier   : ${TINROM_DEFAULT_TIER}")
message(STATUS "  log to serial  : ${TINROM_LOG_TO_SERIAL}")
message(STATUS "  rom size       : ${TINROM_ROM_SIZE} @ ${TINROM_ROM_BASE}")
message(STATUS "  licence string : ${TINROM_ROM_LICENCE_STRING}")
message(STATUS "  crash screen   : ${TINROM_ROM_CRASH_SCREEN}")
message(STATUS "  packed payload : ${TINROM_ROM_COMPRESS}")
message(STATUS "  mkpsxiso       : ${MKPSXISO_PATH}")
message(STATUS "  modules        : ${TINROM_ENABLED_MODULES}")
if("${TINROM_OPTIMIZE}" STREQUAL "")
	set(tinromOptimizeShown "the build type's")
else()
	set(tinromOptimizeShown "${TINROM_OPTIMIZE}")
endif()
message(STATUS "  model          : ${TINROM_MODEL}, debugger: ${TINROM_DEBUGGER}, \
${tinromOptimizeShown}")
foreach(image ROM ISO)
	if(image STREQUAL "ROM")
		set(tinromShownPayload ${tinromRomPayload})
		set(tinromShownName "cart rom       ")
	else()
		set(tinromShownPayload ${tinromIsoPayload})
		set(tinromShownName "boot disc      ")
	endif()

	if(tinromShownPayload STREQUAL "tinrom")
		message(STATUS "  ${tinromShownName}: same payload as the rest")
	else()
		message(STATUS "  ${tinromShownName}: ${tinromShownPayload}.psexe - left out: \
${TINROM_${image}_EXCLUDE_MODULES}")
	endif()
endforeach()
if(TINROM_ROM_SMALL)
	if(tinromSmallPayload STREQUAL "tinrom_small")
		message(STATUS "  small cart rom : ${tinromSmallRom}, tinrom_small.psexe - model \
${TINROM_ROM_SMALL_MODEL}, debugger ${TINROM_ROM_SMALL_DEBUGGER}, ${TINROM_ROM_SMALL_OPTIMIZE}")
		message(STATUS "    left out     : ${TINROM_ROM_SMALL_EXCLUDE_MODULES}")
		message(STATUS "    modules      : ${tinrom_small_MODULES}")
	else()
		message(STATUS "  small cart rom : ${tinromSmallRom}, ${tinromSmallPayload}.psexe as the \
memory card")
	endif()
else()
	message(STATUS "  small cart rom : off (TINROM_ROM_SMALL)")
endif()
if(tinromCardPayload STREQUAL "tinrom")
	message(STATUS "  memory card    : same payload as the rest")
else()
	message(STATUS "  memory card    : tinrom_card.psexe - model ${TINROM_MCR_MODEL}, \
debugger ${TINROM_MCR_DEBUGGER}, ${TINROM_MCR_OPTIMIZE}")
	message(STATUS "    left out     : ${TINROM_MCR_EXCLUDE_MODULES}")
	message(STATUS "    modules      : ${tinrom_card_MODULES}")
endif()
message(STATUS "    packed       : ${TINROM_MCR_COMPRESS}")
message(STATUS "")

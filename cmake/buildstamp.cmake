#
# Build stamp generator. Run with cmake -P:
#
#   cmake -DOUTPUT=<path> -DVERSION=0.1.0 [-DSTAMP=YYMMDDHHMM]
#         -P cmake/buildstamp.cmake
#
# The stamp is the local date and time as YYMMDDHHMM, read as a decimal number
# and written in hex: 26-09-16 13:40 is 2609161340 is 9B84A47C. Short enough to
# read out over the phone, and ordered - a later build always sorts after an
# earlier one.
#
# It writes a C file rather than a header on purpose: the value changes every
# build, and a header that changes every build rebuilds everything that
# includes it. This way one object file is recompiled and the link redone.
#
# No Python and no other tool: this runs on the cmake that is already building
# the project.

cmake_minimum_required(VERSION 3.25)

if(NOT DEFINED OUTPUT)
	message(FATAL_ERROR "buildstamp.cmake: -DOUTPUT=<path> is required")
endif()
if(NOT DEFINED VERSION)
	message(FATAL_ERROR "buildstamp.cmake: -DVERSION=<x.y.z> is required")
endif()

if(NOT DEFINED STAMP OR STAMP STREQUAL "")
	string(TIMESTAMP STAMP "%y%m%d%H%M")
endif()

if(NOT STAMP MATCHES "^[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]$")
	message(FATAL_ERROR
		"buildstamp.cmake: STAMP must be ten digits (YYMMDDHHMM), got '${STAMP}'")
endif()

# Readable form, for the about screen.
string(SUBSTRING "${STAMP}" 0 2 stampYear)
string(SUBSTRING "${STAMP}" 2 2 stampMonth)
string(SUBSTRING "${STAMP}" 4 2 stampDay)
string(SUBSTRING "${STAMP}" 6 2 stampHour)
string(SUBSTRING "${STAMP}" 8 2 stampMinute)
set(readable
	"${stampYear}-${stampMonth}-${stampDay} ${stampHour}:${stampMinute}")

# Strip leading zeros before the arithmetic so nothing reads it as octal. Only
# reachable for years before 2010, but a build that silently changes base is
# not the kind of surprise to leave lying around.
string(REGEX REPLACE "^0+" "" decimal "${STAMP}")
if(decimal STREQUAL "")
	set(decimal "0")
endif()

math(EXPR value "${decimal}" OUTPUT_FORMAT HEXADECIMAL)
string(REGEX REPLACE "^0[xX]" "" value "${value}")
string(TOUPPER "${value}" value)

# Pad to eight digits. It grows a ninth in 2043, when YYMMDDHHMM passes 2^32 -
# the string stays fine, but tinromBuildStamp below wraps, so the number is the
# thing to stop trusting then, not the text.
string(LENGTH "${value}" length)
while(length LESS 8)
	set(value "0${value}")
	string(LENGTH "${value}" length)
endwhile()

# ";" is a list separator inside set(), and escaping it leaks the backslash
# into the file. Build it as a character instead.
string(ASCII 59 semi)

set(generated
"/* tinrom - generated by cmake/buildstamp.cmake. Do not edit. */

#include <stdint.h>

const char tinromBuildNumber[] = \"${value}\"${semi}
const char tinromBuildTime[]   = \"${readable}\"${semi}
const char tinromVersionFull[] = \"${VERSION}-${value}\"${semi}

const uint32_t tinromBuildStamp = ${decimal}u${semi}
")

# Only touch the file when it would change, so two builds in the same minute
# do not relink for nothing.
set(existing "")
if(EXISTS "${OUTPUT}")
	file(READ "${OUTPUT}" existing)
endif()

if(NOT existing STREQUAL generated)
	file(WRITE "${OUTPUT}" "${generated}")
	message(STATUS "tinrom build ${VERSION}-${value}  (${readable})")
endif()
